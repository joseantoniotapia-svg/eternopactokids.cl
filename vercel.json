{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "c" }], "destination": "/app" },
    { "source": "/", "has": [{ "type": "query", "key": "com" }], "destination": "/app" },
    { "source": "/", "has": [{ "type": "query", "key": "asis" }], "destination": "/app" },
    { "source": "/", "has": [{ "type": "host", "value": "eternopactokids.cl" }], "destination": "/inicio" },
    { "source": "/", "has": [{ "type": "host", "value": "www.eternopactokids.cl" }], "destination": "/inicio" },
    { "source": "/", "destination": "/app" }
  ],
  "headers": [
    { "source": "/bib/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] }
  ]
}
